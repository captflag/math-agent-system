# Anthropic API key (or leave unset and use `ant auth login` / ambient env)
ANTHROPIC_API_KEY=

# Model & agent behavior
MODEL=claude-opus-5
EFFORT=high
MAX_TOOL_TURNS=12
MAX_WEB_SEARCHES=3

# Self-correction & cost cascade
SELF_CORRECT=true
ENABLE_CASCADE=false
CASCADE_MODEL=claude-haiku-4-5

# Guardrails
ENABLE_INPUT_GUARDRAILS=true
MAX_QUESTION_LENGTH=2000
RATE_LIMIT_PER_MINUTE=30
